{
  "displayName": "Flexom",
  "name": "@valeriansaliou/homebridge-flexom",
  "version": "4.0.0",
  "description": "Control Flexom devices with Homekit.",
  "author": {
    "name": "Raphaël Sauget"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/valeriansaliou/homebridge-flexom.git"
  },
  "bugs": {
    "url": "https://github.com/valeriansaliou/homebridge-flexom/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "watch": "npm run build && nodemon",
    "start": "nodemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:smoke": "node scripts/smoke-test.cjs"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@homebridge/hap-nodejs": "2.2.2",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "homebridge": "2.4.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "release-it": "21.1.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.4.0"
  },
  "files": [
    "dist",
    "config.schema.json"
  ]
}
